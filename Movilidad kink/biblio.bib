@incollection{Solon_1999,
booktitle = {Handbook of Labor Economics},
title = {Chapter 29 - Intergenerational Mobility in the Labor Market},
editor = {Orley C. Ashenfelter and David Card},
series = {Handbook of Labor Economics},
publisher = {Elsevier},
volume = {3},
pages = {1761-1800},
year = {1999},
issn = {1573-4463},
